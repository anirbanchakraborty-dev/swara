; Every block and every music container folds. Neovim folds only nodes that
; span more than one line, so a one-line list or block stays open.

[
  (header_block)
  (paper_block)
  (layout_block)
  (midi_block)
  (context_definition)
  (score_block)
  (book_block)
  (bookpart_block)
  (sequential_music)
  (simultaneous_music)
  (alternative)
  (with_block)
  (markup_block)
  (scheme_list)
  (scheme_vector)
  (embedded_lilypond)
  (block_comment)
] @fold
